# Copy outside the checkout; protect the real file and TLS private key.
APP_IMAGE=loanrun-backend:replace-with-verified-commit-sha
POSTGRES_DB=loanrun
POSTGRES_USER=loanrun
POSTGRES_PASSWORD=replace-with-a-private-password
PUBLIC_HOST=loanrun.example.invalid
PUBLIC_ORIGIN=https://loanrun.example.invalid
ALLOWED_ORIGINS=https://loanrun.example.invalid
TLS_DIRECTORY=/opt/loanrun/tls
# The directory contains fullchain.pem and privkey.pem. No certificate is issued by Compose.
DEMO_MODE=false
RISK_HISTORY_ENABLED=true
FSS_ENABLED=false
FSS_API_KEY=
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
